{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".build/types/**/*.ts",
    ".build/dev/types/**/*.ts",
    ".next_dev/types/**/*.ts",
    ".next_dev/dev/types/**/*.ts",
    ".dist/types/**/*.ts",
    ".dist/dev/types/**/*.ts",
    ".next_app/types/**/*.ts",
    ".next_app/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/app/_legacy",
    ".next_app",
    ".next",
    ".next_dev",
    ".build",
    ".dist"
  ]
}
